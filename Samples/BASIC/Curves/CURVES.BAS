10 REM *** CURVES ***
20 DEGREE:CLS
30 LINE (0,0)-(239,31),S,&HFFFF,B
40 LINE (0,16)-(239,16),&H6666
50 FOR X=0 TO 239
60 Y=16-12*SIN (X*3)
70 PSET (X,Y)
80 NEXT X
90 FOR X=0 TO 239 STEP 2
100 Y=16-8*COS (X*6)
110 PSET (X,Y)
120 NEXT X
130 LOCATE 1,0:PRINT "SIN AND COS";
140 IF INKEY$="" THEN 140
150 END
