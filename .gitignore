# 個人の環境（PC のパスを含む）
/.claude/*
!/.claude/skills/
/.vscode/

# 作業用一時ファイル（マニュアルスキャン等を含むため公開しない）
/Assembler/tmp/
/DisAssembler/tmp/
/Assembler/tests/output/

# ビルド生成物
bin/
!/VSCodeExtensions/pc-e500-devtools/bin/
obj/
*.obj
*.user
.vs/
node_modules/
/VSCodeExtensions/pc-e500-devtools/out/
# npm のパッケージ（node scripts/npm-package.js が作る）
/VSCodeExtensions/pc-e500-devtools/npm-dist/
# skills/ の写し（VSIX に入れるため、npm run copy:skill が作る）
/VSCodeExtensions/pc-e500-devtools/skills/

# .NET 製の自己完結型 EXE（各 70〜120 MB）は GitHub の 1 ファイル上限を超えるため同梱しない
# → GitHub Releases から取得するか、各フォルダの build.cmd でビルドする（app/ に生成される）
/Assembler/app/*.exe
/DisAssembler/app/*.exe

# Linux / macOS 用の実行ファイル（build.sh や build.ps1 -Runtime で生成する）
/Assembler/app/e500asm
/DisAssembler/app/e500dasm
/Assembler/app/*/
/DisAssembler/app/*/

# VSIX は GitHub Releases で配布する
